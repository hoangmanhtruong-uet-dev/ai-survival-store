# ==========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG: MÈO DEV SINH TỒN
# Copy file này thành .env.local và điền thông tin của bạn.
# ==========================================================

# 1. Cổng Thanh Toán VietQR (Ngân hàng nhận tiền trực tiếp)
NEXT_PUBLIC_VIETQR_BANK_ID=MBBank
NEXT_PUBLIC_VIETQR_ACCOUNT_NO=01012076666
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=HOANG MANH TRUONG

# 2. Webhook Token Bảo Mật & Quản trị
PAYMENT_WEBHOOK_SECRET=meo_dev_secret_token_2026
ADMIN_SECRET_KEY=meo_dev_admin_secret_2026

# 3. Cổng Thanh Toán PayOS (payos.vn - Tùy chọn)
# Lấy tại Kênh thanh toán -> Thông tin kết nối trên dashboard PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# 4. Google Gemini API (Dành cho Chatbot bán hàng + Roast CV + Bói Tarot)
# Lấy miễn phí tại https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 5. Supabase Database & Realtime (Tùy chọn - Nếu trống sẽ tự dùng Mock Store)
# Lấy tại Settings -> API trên dashboard Supabase: https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 6. Cloudflare R2 Storage (Tùy chọn - Phân phối tài liệu số qua S3 API)
# Nếu để trống sẽ tự động phục vụ file mẫu từ thư mục public/sample-files/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=meo-dev-assets
R2_PUBLIC_DOMAIN=

# 7. Meta Official Social Publishing (Tự động đăng bài lên Facebook Fanpage & Threads)
# Facebook Page: Cần ID Fanpage và Page Access Token (quyền pages_manage_posts)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Threads API: Cần Threads User ID và Threads Access Token (quyền threads_content_publish)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# 8. Antigravity CLI Coder (Tùy chọn - Dành cho lệnh /code từ Telegram)
# Đường dẫn nhị phân agy trên VPS (mặc định tìm ~/.gemini/bin/agy hoặc /usr/local/bin/agy)
AGY_BIN_PATH=
# Model dùng cho Antigravity CLI (Ví dụ: gemini-3.8-flash-high, claude-sonnet-4-6)
AGY_MODEL=gemini-3.8-flash-high
# Mức độ suy luận: low, medium, high
AGY_EFFORT=high

